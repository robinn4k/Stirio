node_modules/
package-lock.json

# EUVS Archive — dev-only artifacts. NUNCA commitear ni cachear los PDFs:
# son decenas de GB y la app no los sirve (solo enlaza a archive.org).
tools/euvs-archive/.venv/
tools/euvs-archive/__pycache__/
tools/euvs-archive/data/downloads/
tools/euvs-archive/data/logs/
tools/euvs-archive/data/skeletons/
tools/euvs-archive/data/enrichments/
data/euvs-pending.tsv
*.pdf

# AI content tooling — local venv, env file with secrets, and per-run reports.
# Reports are useful as artefactos de PR (the workflow uploads them as
# artifacts) but we never commit them to keep the repo clean.
tools/ai-content/.venv/
tools/ai-content/__pycache__/
tools/ai-content/.env
tools/ai-content/reports/*
!tools/ai-content/reports/.gitkeep
