rules_version = '2';

// Stirio — Firestore security rules.
//
// IMPORTANTE: este archivo describe las reglas deseadas pero NO se despliega
// automáticamente en Firebase. Para aplicarlas:
//
//     firebase deploy --only firestore:rules
//
// Antes de desplegar, compara con las reglas vivas en la consola:
//     https://console.firebase.google.com/project/dblearn-45fcc/firestore/rules
// y valida en local con `firebase emulators:start --only firestore`.
//
// Filosofía:
//   - Lectura pública de scores/users porque el leaderboard es anónimo (también
//     para guests). Si se añaden datos sensibles al doc de usuario, moverlos a
//     /users/{uid}/private/* (subcolección ya protegida).
//   - Escritura siempre ligada a `request.auth.uid` — ningún usuario puede
//     escribir en nombre de otro.
//   - El campo `uid` dentro del documento debe coincidir con el uid del
//     usuario autenticado (defensa contra spoof).
//   - Validación de tamaños/tipos para impedir inflación artificial de score
//     y nombres abusivos.
//
// Nota: estas reglas NO sustituyen a Firebase App Check. Aun con rules
// perfectas, sin App Check un bot con un anonymous signin puede inflar el
// leaderboard. Activar App Check es el siguiente paso (docs/security-checklist.md).

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Leaderboard ---
    // Doc id determinista `${uid}_${roundId}` (ver js/leaderboard.js:75).
    // Campos reales: uid, name, roundId, roundTitle, score, corrects, wrongs, date, isGuest.
    match /scores/{scoreId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.score <= 1000000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // --- Perfil de usuario ---
    // Lectura pública necesaria para listar el leaderboard
    // (ver js/leaderboard.js:126 — query sobre collection('users')).
    // Escritura solo por el propietario y con uid coherente.
    match /users/{userId} {
      allow read: if true;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && (!('uid' in request.resource.data)
            || request.resource.data.uid == userId);
    }

    // Sub-colecciones privadas del usuario (placeholder para futuras
    // propiedades sensibles como email, onboarding detallado, etc.).
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId;
    }

    // Deny-by-default para cualquier otra ruta. Mover aquí explícitamente
    // toda colección nueva antes de usarla desde el cliente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
